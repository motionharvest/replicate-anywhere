{
	"compilerOptions": {
	  "target": "ES2020",
	  "module": "ES2020",
	  "moduleResolution": "node",
	  "esModuleInterop": true,
	  "allowSyntheticDefaultImports": true,
	  "strict": true,
	  "outDir": "build",
	  "skipLibCheck": true,
	  "forceConsistentCasingInFileNames": true,
	  "types": ["node"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
  }